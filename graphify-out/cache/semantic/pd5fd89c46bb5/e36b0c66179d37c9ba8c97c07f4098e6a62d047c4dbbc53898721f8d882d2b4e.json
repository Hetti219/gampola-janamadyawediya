{"nodes": [{"id": "theme_gampola_janamadyawediya_assets_img_logo", "label": "Gampola Janamadyawediya Logo (circular badge)", "file_type": "image", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Circular seal/badge format chosen to read as an institutional masthead mark; three concentric rings let the publication name, its web address, and its full editorial scope coexist in one lockup without additional type."}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_gampola_janamadyawediya", "label": "Gampola Janamadyawediya (publication name)", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rendered twice in the outer red ring - Latin transliteration at top, Sinhala-Latin caps at bottom - so the identity carries the place name Gampola and the Sinhala-derived word janamadyawediya (media/journalist) for a local audience."}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_gampolajanamadyawediyacom", "label": "gampolajanamadyawediya.com (web address)", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_truth_and_trust", "label": "Truth and Trust (tagline)", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed directly under the word NEWS inside the inner circle: states the editorial values claim (truthfulness plus reader trust) that the publication positions itself on."}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_eye_aperture_pen_mark", "label": "Eye, Camera-Aperture Iris and Fountain Pen Mark", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composite emblem: a fountain pen forms the eyebrow of a large eye whose pupil is a camera iris/aperture. It fuses the two tools of the trade - written reporting and photojournalism - into one 'watchful' mark, reinforcing the watchdog/observation idea behind local news coverage."}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_editorial_sections", "label": "Editorial Section Ring (Local News, International News, Art and Culture, Sports, Cinema, Gossip, Education, Entertainment, Politics, Technology)", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The middle navy ring enumerates the site's content categories on the logo itself, declaring the publication's coverage scope (hard news, culture, sport, entertainment, lifestyle) as part of the brand mark."}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_crimson_navy_palette", "label": "Crimson and Navy Split-Circle Palette", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inner circle is split vertically - navy on the left, crimson red on the right - with white/yellow type for contrast. The high-saturation red reads as breaking-news urgency while navy grounds it as authoritative; the split also gives the emblem a clear left/right division so the pen-and-eye mark stays legible at favicon size."}, {"id": "theme_gampola_janamadyawediya_assets_img_logo_notion_section", "label": "Ring Section Read as 'NOTION' (uncertain - possibly 'Motion' or a transposed label)", "file_type": "concept", "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One segment of the yellow category ring reads NOTION between GOSSIP and EDUCATION; the reading is uncertain at this resolution and may be a typo or a scanning artifact of the curved text. Flagged for human review."}], "edges": [{"source": "theme_gampola_janamadyawediya_assets_img_logo", "target": "theme_gampola_janamadyawediya_assets_img_logo_gampola_janamadyawediya", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "weight": 1.0}, {"source": "theme_gampola_janamadyawediya_assets_img_logo", "target": "theme_gampola_janamadyawediya_assets_img_logo_gampolajanamadyawediyacom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "weight": 1.0}, {"source": "theme_gampola_janamadyawediya_assets_img_logo", "target": "theme_gampola_janamadyawediya_assets_img_logo_truth_and_trust", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "weight": 1.0}, {"source": "theme_gampola_janamadyawediya_assets_img_logo", "target": "theme_gampola_janamadyawediya_assets_img_logo_eye_aperture_pen_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "theme/gampola-janamadyawediya/assets/img/logo.jpeg", "source_location": null, "weight": 1.0}, {"source": "theme_gampola_janamadyawediya_assets_img_logo", "target": "theme_gampola_janamadyawediya_assets_img_logo_editorial_sections", "relation": "references", "confi