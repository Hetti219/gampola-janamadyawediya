{"nodes": [{"id": "docker_compose_override", "label": "Local Development Compose Override", "file_type": "code", "source_file": "docker-compose.override.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-merged by Docker Compose when present in the same directory, so it must never exist on the server - the README's deployment steps delete it, otherwise production would serve the local config on port 8080."}, {"id": "docker_compose_override_local_dev_stack", "label": "Local Dev Stack at localhost:8080 Without SSL", "file_type": "concept", "source_file": "docker-compose.override.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes the need for SSL certs locally by serving HTTP on 8080 from nginx/local/local.conf and pointing WP_SITEURL/WP_HOME at http://localhost:8080."}, {"id": "docker_compose_override_override_tag", "label": "!override YAML Tag Replacing the Production Port List", "file_type": "rationale", "source_file": "docker-compose.override.yml", "source_location": "line 13-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compose merges port lists by appending, so !override replaces them entirely and the dev stack binds only 8080 instead of also opening 80/443 on the developer machine; volume mounts are keyed by container path so the local vhost mount replaces the prod one."}], "edges": [{"source": "docker_compose_override", "target": "docker_compose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.override.yml", "source_location": "line 2-3", "weight": 1.0}, {"source": "docker_compose_override_local_dev_stack", "target": "docker_compose_override", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.override.yml", "source_location":