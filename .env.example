# Copy this file to .env and fill in real values.
# Never commit the real .env file to any public repo.

# Docker Compose uses this to prefix container and volume names.
# backup.sh derives the volume name from this automatically.
COMPOSE_PROJECT_NAME=gampola-janamadyawediya

DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=change_me_to_a_strong_random_password
DB_ROOT_PASSWORD=change_me_to_a_different_strong_random_password

# Generate strong passwords with:
#   openssl rand -base64 24

# Your production domain (without https://). Used by deploy.sh for the
# wp-cron host cron job and post-deploy cache warming.
DOMAIN=

# Cloudflare cache purge credentials (mu-plugins/cloudflare-purge.php).
# Create a scoped API token with Cache Purge + Zone Read permissions only.
# The purge plugin no-ops gracefully when these are unset.
CF_ZONE_ID=
CF_API_TOKEN=

